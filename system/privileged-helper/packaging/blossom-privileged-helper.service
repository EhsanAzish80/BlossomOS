[Unit]
Description=Blossom OS minimal privileged helper
Documentation=https://github.com/EhsanAzish80/BlossomOS
After=dbus.service polkit.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.blossomos.Privileged1
ExecStart=/usr/lib/blossom-os/blossom-privileged-helper
User=root
Group=root
UMask=0077
RuntimeDirectory=blossom-privileged/journal blossom-privileged/audit
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Restart=no
TimeoutStartSec=15s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/blossom-privileged
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=32
MemoryMax=128M
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
