<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Blossom OS</vendor>
  <vendor_url>https://github.com/EhsanAzish80/BlossomOS</vendor_url>
  <action id="org.blossomos.privileged1.try-restart-bluetooth">
    <description>Restart the running Bluetooth service</description>
    <message>Authentication is required to restart the running Bluetooth service</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
