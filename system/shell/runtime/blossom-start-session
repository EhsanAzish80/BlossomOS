#!/usr/bin/env bash
set -euo pipefail

# Hyprland creates these values after the per-user systemd manager has
# started. Import the compositor environment before starting graphical
# services so their Wayland clients can connect to the live display.
systemctl --user import-environment \
  WAYLAND_DISPLAY \
  HYPRLAND_INSTANCE_SIGNATURE \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_DESKTOP \
  XDG_SESSION_TYPE
if [[ -n ${BLOSSOM_LIVE:-} ]]; then
  systemctl --user import-environment BLOSSOM_LIVE
fi

systemctl --user start graphical-session.target blossom-shell-ui.service
