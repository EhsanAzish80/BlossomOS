[Unit]
Description=Blossom OS unprivileged shell broker
Documentation=https://github.com/EhsanAzish80/BlossomOS
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.blossomos.Shell1
ExecStart=/usr/lib/blossom-os/blossom-shell-service
Restart=no
TimeoutStartSec=15s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# Empty read-only home/runtime trees, with only the session bus socket visible.
ProtectHome=tmpfs
BindReadOnlyPaths=%t/bus
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Bubblewrap requires NETLINK_ROUTE while constructing its private, networkless
# namespace. AF_INET and AF_INET6 remain unavailable to this service.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=yes
# Do not set RestrictSUIDSGID here: systemd implements it by denying openat2(),
# which Bubblewrap requires to construct code-owned read-only mounts safely.
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
TasksMax=64
MemoryMax=256M
IPAddressDeny=any

# Deliberately no enablement section: Phase 6 evidence activates this unit only
# inside a disposable user session.
