<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Blossom OS</vendor>
  <vendor_url>https://github.com/EhsanAzish80/BlossomOS</vendor_url>
  <action id="org.blossomos.shell.approve-model-effect">
    <description>Approve one exact model-proposed effect</description>
    <message>Authentication is required to approve this exact Blossom OS effect</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
