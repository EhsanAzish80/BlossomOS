[Unit]
Description=Blossom OS shell broker for user %i
Documentation=https://github.com/EhsanAzish80/BlossomOS
BindsTo=user@%i.service
After=user@%i.service
RequiresMountsFor=/run/user/%i

[Service]
Type=simple
ExecCondition=/usr/bin/test %i = 1000
User=%i
Group=%i
SupplementaryGroups=blossom-ai
Environment=HOME=/home/blossom
Environment=XDG_RUNTIME_DIR=/run/user/%i
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%i/bus
ExecStart=/usr/lib/blossom-os/blossom-shell-service
Restart=no
TimeoutStartSec=15s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user/%i/bus
BindPaths=/home/blossom/Workspace
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
TasksMax=64
MemoryMax=256M
IPAddressDeny=any
