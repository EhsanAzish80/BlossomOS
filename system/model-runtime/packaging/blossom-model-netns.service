[Unit]
Description=Blossom OS private model network namespace
Documentation=https://github.com/EhsanAzish80/BlossomOS
Before=blossom-model-gateway.service blossom-model-ollama.service blossom-model-llama-cpp.service

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes
PrivateNetwork=yes
User=blossom-model-gateway
Group=blossom-model-gateway
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/boot -/etc -/home -/media -/mnt -/opt -/root -/run -/srv -/var
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=4
MemoryMax=32M
MemorySwapMax=0
CPUQuota=10%
LimitCORE=0
LimitFSIZE=0
LimitNOFILE=32
IPAddressDeny=any
