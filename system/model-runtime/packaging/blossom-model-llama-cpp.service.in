[Unit]
Description=Blossom OS isolated llama.cpp CPU provider
Documentation=https://github.com/EhsanAzish80/BlossomOS
Requires=blossom-model-netns.service
After=blossom-model-netns.service
Before=blossom-model-gateway.service
JoinsNamespaceOf=blossom-model-netns.service

[Service]
Type=simple
ExecStart=@PROVIDER_BINARY@ --model @MODEL_PATH@ --no-webui
User=blossom-model-provider
Group=blossom-model-provider
DynamicUser=no
UMask=0077
StateDirectory=blossom/model-provider/llama-cpp
StateDirectoryMode=0700
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/boot -/etc -/home -/media -/mnt -/opt -/root -/run/user -/srv -/usr/lib/blossom-os
BindReadOnlyPaths=@PROVIDER_DIRECTORY@ @MODEL_PATH@
ReadWritePaths=/var/lib/blossom/model-provider/llama-cpp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=@TASKS_MAX@
MemoryMax=@MEMORY_MAX@
MemorySwapMax=@MEMORY_SWAP_MAX@
CPUQuota=@CPU_QUOTA@
LimitCORE=0
LimitFSIZE=@FILE_SIZE_MAX@
LimitNOFILE=@OPEN_FILES_MAX@
TimeoutStartSec=30s
TimeoutStopSec=10s
Restart=no
IPAddressAllow=localhost
IPAddressDeny=any
Environment=HOME=/var/lib/blossom/model-provider/llama-cpp
