[Unit]
Description=Blossom OS local model gateway
Documentation=https://github.com/EhsanAzish80/BlossomOS
Requires=blossom-model-netns.service
After=blossom-model-netns.service
JoinsNamespaceOf=blossom-model-netns.service
StopWhenUnneeded=yes

[Service]
Type=simple
ExecStart=/usr/lib/blossom-os/blossom-model-gateway
User=blossom-model-gateway
Group=blossom-model-gateway
SupplementaryGroups=blossom-ai
DynamicUser=no
UMask=0077
RuntimeDirectory=blossom-model-gateway
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/boot /etc /home /media /mnt /opt /root /srv /run/user /usr/lib/blossom-os
BindReadOnlyPaths=/usr/lib/blossom-os/blossom-model-gateway /etc/blossom-os/model-profiles /etc/passwd /etc/group /proc/sys/kernel/random/boot_id
ReadWritePaths=/run/blossom-model-gateway
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=32
MemoryMax=256M
MemorySwapMax=0
CPUQuota=100%
LimitCORE=0
LimitFSIZE=1M
LimitNOFILE=256
TimeoutStartSec=15s
TimeoutStopSec=10s
Restart=no
IPAddressAllow=localhost
IPAddressDeny=any
