[Unit]
Description=Blossom OS VM qualification model fixture
Requires=blossom-model-netns.service
After=blossom-model-netns.service
Before=blossom-model-gateway.service
JoinsNamespaceOf=blossom-model-netns.service

[Service]
Type=simple
ExecStart=/usr/lib/blossom-os/qualification-fixture-provider
User=blossom-model-provider
Group=blossom-model-provider
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=8
MemoryMax=64M
MemorySwapMax=0
CPUQuota=25%
LimitCORE=0
LimitFSIZE=0
LimitNOFILE=32
IPAddressAllow=localhost
IPAddressDeny=any
Restart=no
