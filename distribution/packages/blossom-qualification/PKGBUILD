pkgname=blossom-qualification
pkgver=0.1.0
pkgrel=1
pkgdesc='Blossom OS VM-only agent qualification tools'
arch=('x86_64' 'aarch64')
license=('Apache-2.0')
depends=('blossom-core' 'python' 'systemd')
source=()
sha256sums=()

package() {
  local repo_root="${BLOSSOM_REPO_ROOT:-$startdir/../../..}"
  install -Dm0755 "$repo_root/scripts/qualify_agent_pipeline.py" \
    "$pkgdir/usr/lib/blossom-os/qualify-agent-pipeline"
  install -Dm0755 "$repo_root/scripts/qualification_fixture_provider.py" \
    "$pkgdir/usr/lib/blossom-os/qualification-fixture-provider"
  install -Dm0755 "$repo_root/scripts/check_shell_broker_runtime.py" \
    "$pkgdir/usr/lib/blossom-os/check-shell-broker-runtime"
  install -Dm0644 "$startdir/blossom-model-fixture.service" \
    "$pkgdir/usr/lib/systemd/system/blossom-model-fixture.service"
  install -Dm0644 "$startdir/qualification-provider.json" \
    "$pkgdir/usr/share/blossom-os/qualification-provider.json"
}
