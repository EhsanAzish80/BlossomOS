pkgname=blossom-core
pkgver=0.9.0
pkgrel=3
pkgdesc='Blossom OS reviewed service boundaries'
arch=('x86_64' 'aarch64')
license=('Apache-2.0')
depends=('bubblewrap' 'dbus-broker' 'systemd')
options=('!strip')
source=()
sha256sums=()

build() {
  local repo_root="${BLOSSOM_REPO_ROOT:-$startdir/../../..}"
  CARGO_TARGET_DIR="$srcdir/target" \
    cargo build --locked --offline --release --manifest-path "$repo_root/Cargo.toml"
  # The workspace default intentionally builds the shell broker inert. Release
  # media must replace that artifact with the reviewed production D-Bus build.
  CARGO_TARGET_DIR="$srcdir/target" \
    cargo build --locked --offline --release \
      --manifest-path "$repo_root/Cargo.toml" \
      --package blossom-shell-service \
      --features production-dbus-service
  # The workspace default gateway is intentionally inert. Installed systems
  # must receive the reviewed private Unix-socket transport from ADR-0017.
  CARGO_TARGET_DIR="$srcdir/target" \
    cargo build --locked --offline --release \
      --manifest-path "$repo_root/Cargo.toml" \
      --package blossom-model-gateway \
      --features production-private-inference
}

package() {
  local repo_root="${BLOSSOM_REPO_ROOT:-$startdir/../../..}"
  install -Dm0755 "$srcdir/target/release/blossom-shell-service" \
    "$pkgdir/usr/lib/blossom-os/blossom-shell-service"
  install -Dm0755 "$srcdir/target/release/blossom-model-gateway" \
    "$pkgdir/usr/lib/blossom-os/blossom-model-gateway"
  install -Dm0755 "$srcdir/target/release/blossom-privileged-helper" \
    "$pkgdir/usr/lib/blossom-os/blossom-privileged-helper"
  install -Dm0644 "$repo_root/system/shell/packaging/blossom-shell-broker@.service" \
    "$pkgdir/usr/lib/systemd/system/blossom-shell-broker@.service"
  install -d "$pkgdir/usr/lib/systemd/system/user@1000.service.wants"
  ln -s ../blossom-shell-broker@.service \
    "$pkgdir/usr/lib/systemd/system/user@1000.service.wants/blossom-shell-broker@1000.service"
  install -Dm0644 "$repo_root/system/privileged-helper/packaging/blossom-privileged-helper.service" \
    "$pkgdir/usr/lib/systemd/system/blossom-privileged-helper.service"
  install -Dm0644 "$repo_root/system/privileged-helper/packaging/org.blossomos.Privileged1.service" \
    "$pkgdir/usr/share/dbus-1/system-services/org.blossomos.Privileged1.service"
  install -Dm0644 "$repo_root/system/privileged-helper/packaging/org.blossomos.Privileged1.conf" \
    "$pkgdir/usr/share/dbus-1/system.d/org.blossomos.Privileged1.conf"
  install -Dm0644 "$repo_root/system/privileged-helper/packaging/org.blossomos.privileged1.policy" \
    "$pkgdir/usr/share/polkit-1/actions/org.blossomos.privileged1.policy"
  install -Dm0644 "$repo_root/system/shell/packaging/org.blossomos.shell.policy" \
    "$pkgdir/usr/share/polkit-1/actions/org.blossomos.shell.policy"
  install -Dm0644 "$repo_root/system/shell/packaging/50-blossom-core.preset" \
    "$pkgdir/usr/lib/systemd/system-preset/50-blossom-core.preset"
}
