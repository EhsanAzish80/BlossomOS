[Unit]
Description=Blossom OS ARM64 automated runtime qualification
ConditionPathExists=/dev/virtio-ports/org.blossomos.qualification
After=graphical.target NetworkManager-wait-online.service
Wants=NetworkManager-wait-online.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/blossom-arm64-qualification-probe
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=480
